# Copy this file to .env.test.local and fill it with dedicated, non-production credentials.
# Keep .env.test.local private (mode 0600 on Unix) and never commit it.
# The remote MySQL suite stays disabled while any required value is empty.
TUIMINAL_TEST_MYSQL_HOST=
TUIMINAL_TEST_MYSQL_PORT=3306
TUIMINAL_TEST_MYSQL_DATABASE=
TUIMINAL_TEST_MYSQL_USER=
TUIMINAL_TEST_MYSQL_PASSWORD=
TUIMINAL_TEST_MYSQL_TLS=1
TUIMINAL_TEST_MYSQL_WRITES=1

### JSON body
# @name json-body
POST https://example.test/users
Content-Type: application/json

{
  "name": "Ada",
  "roles": ["admin", "developer"]
}

### Form body
# @name form-body
POST https://example.test/form
Content-Type: application/x-www-form-urlencoded

field1=value%2Bvalue&field2=value%26value

### File body
# @name file-body
POST https://example.test/import
Content-Type: application/json

< ./payload.json

### Multipart body
# @name multipart-body
POST https://example.test/upload
Content-Type: multipart/form-data; boundary=TuiminalFixtureBoundary

--TuiminalFixtureBoundary
Content-Disposition: form-data; name="caption"

terminal workspace
--TuiminalFixtureBoundary
Content-Disposition: form-data; name="upload"; filename="payload.txt"

< ./payload.txt
--TuiminalFixtureBoundary--

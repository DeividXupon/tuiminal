{
  "name": "tuiminal",
  "version": "0.2.0-pre-alpha.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "bin": {
    "tuiminal": "./bin/tuiminal.ts"
  },
  "scripts": {
    "check": "bun run typecheck && bun run format:check && bun run lint && bun run check:architecture && bun run check:maintainability && bun run test",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:maintainability": "bun scripts/check-maintainability.ts",
    "build:release": "bun scripts/build-release.ts",
    "docs:demos": "bun scripts/generate-readme-demos.tsx",
    "format": "biome format --write src bin tests scripts package.json tsconfig.json biome.json .dependency-cruiser.cjs",
    "format:check": "biome format src bin tests scripts package.json tsconfig.json biome.json .dependency-cruiser.cjs",
    "dev": "bun --watch src/index.tsx",
    "lint": "biome lint src bin tests scripts --max-diagnostics=10",
    "lint:fix": "biome lint --write src bin tests scripts",
    "start": "bun src/index.tsx",
    "test": "bun run test:unit && bun run test:tui",
    "test:unit": "bun test tests/*.test.ts",
    "test:tui": "bun test --preload ./tests/tui/setup.ts tests/tui",
    "test:database:drivers": "TUIMINAL_DATABASE_INTEGRATION=1 bun test tests/database-drivers.integration.test.ts --timeout 120000",
    "typecheck": "bun node_modules/typescript-native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "@tuiparts/core": "^0.0.6",
    "@tuiparts/react": "^0.0.6",
    "react": "^19.2.8",
    "string-width": "^7.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "dependency-cruiser": "18.2.0",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2"
  }
}
